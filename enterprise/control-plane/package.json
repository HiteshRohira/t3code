{
  "name": "@t3tools/enterprise-control-plane",
  "private": true,
  "bin": {
    "t3-enterprise-control-plane": "./src/bin.ts"
  },
  "type": "module",
  "exports": {
    "./CertificateAuthority": {
      "types": "./src/CertificateAuthority.ts",
      "import": "./src/CertificateAuthority.ts"
    },
    "./Config": {
      "types": "./src/Config.ts",
      "import": "./src/Config.ts"
    },
    "./Server": {
      "types": "./src/Server.ts",
      "import": "./src/Server.ts"
    }
  },
  "scripts": {
    "start": "node src/bin.ts",
    "typecheck": "effect-tsgo tsrs --noEmit",
    "test": "vp test run --config ../../vite.config.ts --dir ."
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@node-saml/node-saml": "catalog:",
    "@t3tools/enterprise-protocol": "workspace:*",
    "@t3tools/shared": "workspace:*",
    "effect": "catalog:",
    "jose": "catalog:",
    "node-forge": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "@types/node-forge": "catalog:",
    "vite-plus": "catalog:"
  }
}
