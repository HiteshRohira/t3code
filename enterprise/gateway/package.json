{
  "name": "@t3tools/enterprise-gateway",
  "private": true,
  "bin": {
    "t3-enterprise-gateway": "./src/bin.ts"
  },
  "type": "module",
  "exports": {
    "./Config": {
      "types": "./src/Config.ts",
      "import": "./src/Config.ts"
    },
    "./Gateway": {
      "types": "./src/Gateway.ts",
      "import": "./src/Gateway.ts"
    },
    "./Server": {
      "types": "./src/Server.ts",
      "import": "./src/Server.ts"
    }
  },
  "scripts": {
    "start": "node src/bin.ts",
    "typecheck": "effect-tsgo tsrs --noEmit",
    "test": "vp test run --config ../../vite.config.ts --dir ."
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@t3tools/enterprise-protocol": "workspace:*",
    "@t3tools/shared": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@t3tools/enterprise-control-plane": "workspace:*",
    "@types/node": "catalog:",
    "vite-plus": "catalog:"
  }
}
